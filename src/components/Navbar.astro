---
import { waUrl, SITE_LOGO, SITE_LOGO_ACCENT } from "../data/config";
const waGeneral = waUrl("Hola! Vengo de su página web y me interesa activar una cuenta de streaming. ¿Me pueden dar más información?");
---
<header class="nav">
  <div class="nav-inner">
    <div class="logo display">{SITE_LOGO}<span class="logo-accent">{SITE_LOGO_ACCENT}</span></div>
    <nav class="nav-links">
      <a href="#catalogo">Catálogo</a>
      <a href="#garantias">Garantías</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href={waGeneral} class="nav-cta" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
      Hablar ahora
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: var(--bg-nav);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .logo { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .logo-accent { color: var(--accent); }
  .nav-links { display: flex; gap: 1.75rem; }
  .nav-links a { font-size: 0.92rem; color: var(--text-sub); font-weight: 500; transition: color var(--t); }
  .nav-links a:hover { color: var(--text); }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--green);
    color: #04220f;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    transition: transform var(--t), box-shadow var(--t);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--green) 30%, transparent);
  }
  .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 22px color-mix(in srgb, var(--green) 45%, transparent); }

  @media (max-width: 720px) { .nav-links { display: none; } }
</style>
